# Cloudflare R2 Configuration
# Leave empty to use local fallback mode (files served from local storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Domain Configuration for Subdomain Support
# Example: PRIMARY_DOMAIN=example.com, USE_HTTPS=true
PRIMARY_DOMAIN=
USE_HTTPS=true

# Server Configuration
PORT=3000
ADMIN_PASSWORD=admin888

# Clerk Authentication Configuration
# Get your API keys at https://dashboard.clerk.com/~/api-keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Maintenance Mode (set to true to show maintenance page)
MAINTENANCE_MODE=false

# Database Storage
# Default: SQLite (data/app.db with WAL mode, zero configuration needed)
# DB_FILE=data/app.db
